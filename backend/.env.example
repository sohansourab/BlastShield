# Copy to backend/.env and fill in. NEVER commit the filled-in file.

# --- FalkorDB ---
# Local Docker (default): `docker compose up -d`
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=secops_graph

# FalkorDB Cloud (no local setup): uncomment ONE of the two forms below.
# Simplest is the single URL form — `rediss://` implies TLS:
# FALKORDB_URL=rediss://default:<password>@<host>:<port>
# ...or use the discrete fields:
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=
# FALKORDB_TLS=true
# FALKORDB_SSL_CERT_REQS=required

# --- Optional in-process agent (any OpenAI-compatible endpoint) ---
# BlastShield's PRIMARY path is OpenCode-native: the four graph tools are served
# over MCP (backend/mcp_server.py + opencode.json) and driven by OpenCode's own
# models, so no external API is required. Set the variables below only if you
# also want the FastAPI /api/investigate endpoint to run the ReAct loop itself.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=local
